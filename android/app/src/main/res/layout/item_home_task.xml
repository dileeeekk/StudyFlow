<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/home_task_problem" android:layout_marginTop="12dp" android:clipChildren="false" android:clipToPadding="false">
  <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="-20dp" android:layout_marginEnd="-20dp" android:layout_marginTop="-15dp" android:layout_marginBottom="-25dp" android:src="@drawable/home_card_shadow" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:background="@drawable/bg_login_card" android:padding="16dp" android:minHeight="98dp">
    <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/home_check_problem" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="12dp" android:button="@null" android:background="@drawable/bg_home_checkbox" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" tools:contentDescription="@string/home_check_problem" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_problem_title" style="@style/StudyFlow.Home.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:fontFamily="@font/inter_semibold" android:textColor="@color/studyflow_ink" tools:text="@string/home_problem" />
      <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_problem_detail" style="@style/StudyFlow.Home.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:fontFamily="@font/inter_regular" android:textColor="@color/studyflow_muted" android:layout_marginTop="7dp" tools:text="@string/home_problem_detail" />
      <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_high" style="@style/StudyFlow.Home.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:fontFamily="@font/inter_semibold" android:textColor="#B94958" android:layout_marginTop="7dp" android:background="@drawable/bg_home_high" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:minHeight="22dp" android:gravity="center" tools:text="@string/home_high" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
            
